# Copy to `.env` and adjust. Loaded by Vite from this directory (`web/`).

# --- tRPC / API (pick one approach) ---

# Direct: browser calls this host for `/api/trpc` (e.g. auth.login).
# Use when the API allows your dev origin (CORS + credentials).
VITE_API_BASE_URL=https://api.tte.tn

# Alternative for local dev: keep requests same-origin (`/api/...` on the Vite port)
# and proxy to the backend (often avoids CORS during development).
# Uncomment and comment out VITE_API_BASE_URL if you prefer this:
# VITE_API_PROXY_TARGET=https://api.tte.tn
